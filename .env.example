# Copy to .env.local for the Vite dev server. See docs/deployment.md for Pages settings.
VITE_REALS_ENVIRONMENT=local
VITE_API_BASE_URL=
# Optional public HTTPS origin for documents under /legal/. Local and dev default
# to https://reals-web.pages.dev. Set this in prod before enabling a legal catalog.
VITE_LEGAL_DOCUMENT_ORIGIN=

# Use the Firebase Web app values for the selected Reals environment.
VITE_FIREBASE_API_KEY=YOUR_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
# Optional for ordinary local requests on localhost/127.0.0.1 with debug off.
# Required for Admin and explicit App Check testing. Hosted dev/prod require Enterprise.
# Local can use v3 if registered. Site keys are public.
VITE_FIREBASE_APP_CHECK_PROVIDER=enterprise
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# false or unset skips App Check for ordinary local Vite DEV requests on localhost/127.0.0.1.
# true opts into the official SDK debug provider on those hosts.
# Never put a generated debug credential here; register it privately in Firebase Console.
VITE_FIREBASE_APP_CHECK_DEBUG=false
# Optional under local Vite DEV on loopback. Keep both flags false or unset in dev/prod.
VITE_LOCAL_FIREBASE_EMAIL_AUTO_VERIFICATION=false

# Opt in to real tab ownership on the loopback Vite dev server only.
# Non-loopback deployments and production builds always enforce it.
VITE_ENFORCE_TAB_OWNERSHIP=false

# Deployed development (development branch in the existing Pages project's Production scope):
# VITE_REALS_ENVIRONMENT=dev
# VITE_API_BASE_URL=<Railway development HTTPS origin>
# Use the development Firebase Web app and Enterprise site key.
#
# Future production (main branch in a separate Pages project):
# VITE_REALS_ENVIRONMENT=prod
# VITE_API_BASE_URL=<production backend HTTPS origin>
# Use the production Firebase Web app and Enterprise site key.
