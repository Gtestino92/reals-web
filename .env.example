# Public client settings: placeholders only. Real values belong in ignored .env.local.
VITE_FIREBASE_API_KEY=YOUR_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT
VITE_FIREBASE_APP_ID=YOUR_WEB_APP_ID
# Register this exact Web app in Firebase App Check. Prefer enterprise; use v3
# only if that is the registered provider. Site keys are public, never debug secrets.
VITE_FIREBASE_APP_CHECK_PROVIDER=enterprise
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Official SDK debug provider: explicit opt-in, Vite DEV only, localhost/127.0.0.1 only.
# Never put a generated debug credential here; register it privately in Firebase Console.
VITE_FIREBASE_APP_CHECK_DEBUG=false
# Disabled unless DEV and a loopback hostname. Never enabled in production builds.
VITE_LOCAL_FIREBASE_EMAIL_AUTO_VERIFICATION=false

# Opt in to real tab ownership on the loopback Vite dev server only.
# Non-loopback deployments and production builds always enforce it.
VITE_ENFORCE_TAB_OWNERSHIP=false
